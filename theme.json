{
  "name": "Casurea",
  "short": "casurea",
  "description": "Casurea - Monitor 极简探针的一个二创主题包",
  "version": "0.1.1",
  "author": "YannickYoung",
  "url": "https://github.com/YoungYannick/monitor-theme-casurea",
  "config": [
    {
      "type": "title",
      "label": "列表与卡片"
    },
    {
      "type": "boolean",
      "key": "globeOn",
      "label": "节点地球",
      "default": false,
      "help": "列表页顶部那颗会自转的地球；关掉＝整块不渲染，顶栏那枚开关也一起收起（开着时访客可自行关）"
    },
    {
      "type": "select",
      "key": "listTop",
      "label": "列表页顶部",
      "default": "both",
      "options": [
        {
          "value": "none",
          "label": "都不显示"
        },
        {
          "value": "groups",
          "label": "只显示分组标签"
        },
        {
          "value": "summary",
          "label": "只显示概览卡片·原版"
        },
        {
          "value": "budget",
          "label": "只显示概览卡片·价值版"
        },
        {
          "value": "both",
          "label": "两个都显示·概览卡片原版"
        },
        {
          "value": "bothBudget",
          "label": "两个都显示·概览卡片价值版"
        }
      ],
      "help": "分组标签行与概览卡片行各要哪一档；概览卡片分原版与价值版两种排法"
    },
    {
      "type": "select",
      "key": "cardStyle",
      "label": "卡片形态",
      "default": "detailedNoLatency",
      "options": [
        {
          "value": "classic",
          "label": "经典：网络速率与总量分两行，延迟收在右上角浮层里"
        },
        {
          "value": "plain",
          "label": "简约：网络合成一行，标签提亮、进度条更细，不含延迟"
        },
        {
          "value": "latency",
          "label": "延迟：网络合成一行，下方带三网延迟"
        },
        {
          "value": "detailed",
          "label": "详细：在延迟之上再加在线时长、价格与到期"
        },
        {
          "value": "detailedNoLatency",
          "label": "详细·无延迟：与详细相同，但不含三网延迟"
        },
        {
          "value": "wide",
          "label": "宽卡：横向大卡，六块版式、不含延迟，列数随容器自适应"
        },
        {
          "value": "compact",
          "label": "紧凑：一行一台的表格，密度最高"
        }
      ],
      "help": "访客默认看到的档位；访客可在顶栏自行更换"
    },
    {
      "type": "title",
      "label": "节点信息"
    },
    {
      "type": "select",
      "key": "remarkPlacement",
      "label": "备注显示位置",
      "default": "both",
      "options": [
        {
          "value": "both",
          "label": "卡片与详情页都显示"
        },
        {
          "value": "card",
          "label": "只在卡片上显示"
        },
        {
          "value": "detail",
          "label": "只在整页详情里显示"
        },
        {
          "value": "none",
          "label": "都不显示"
        }
      ],
      "help": "备注在后台节点里填（公开给访客、私有给自己）；卡片与详情页都摊，逗号或分号分隔＝多枚标签，留空＝不显示"
    },
    {
      "type": "text",
      "key": "pingLines",
      "label": "显示的延迟线路",
      "default": "",
      "help": "每行一个 ping 任务名，最多三条；留空自动取前三条"
    },
    {
      "type": "select",
      "key": "latencyStyle",
      "label": "延迟曲线样式",
      "default": "broken",
      "options": [
        {
          "value": "broken",
          "label": "折线，保留断点（默认）"
        },
        {
          "value": "connected",
          "label": "连续折线"
        },
        {
          "value": "smooth",
          "label": "平滑曲线，保留断点"
        },
        {
          "value": "connectedSmooth",
          "label": "连续平滑曲线"
        }
      ],
      "help": "统一首页卡片、浮层、紧凑展开与节点详情的默认线形；仅影响显示，不改变丢包或无响应数据"
    },
    {
      "type": "title",
      "label": "预算与汇率"
    },
    {
      "type": "text",
      "key": "exchangeRates",
      "label": "自定义汇率",
      "default": "",
      "help": "可选，留空自动获取最新每日参考汇率 每行 CODE=人民币汇率，例如 USD=7.1；代表1单位该币种等于多少人民币 自定义值优先，可补充查不到汇率的币种"
    },
    {
      "type": "boolean",
      "key": "billingOn",
      "label": "账单页面",
      "default": true,
      "help": "顶栏一枚「账单」入口（/billing 路由）：一张表看全站机器的价格、到期、月均价与剩余价值，可切换展示币种，并带到期日历；关掉＝入口整个不显示，路由返回 404"
    },
    {
      "type": "select",
      "key": "billingAccess",
      "label": "账单页权限",
      "default": "everyone",
      "options": [
        {
          "value": "everyone",
          "label": "所有人"
        },
        {
          "value": "admin",
          "label": "管理员"
        }
      ],
      "help": "谁能打开账单页：所有人可看，或仅管理员（站长登录状态）可见；仅管理员时其他人看不到入口，直接访问路由也返回 404"
    },
    {
      "type": "title",
      "label": "外观"
    },
    {
      "type": "select",
      "key": "themeMode",
      "label": "主题模式",
      "default": "system",
      "options": [
        {
          "value": "system",
          "label": "随系统设置"
        },
        {
          "value": "auto",
          "label": "随北京时间自动切换"
        },
        {
          "value": "light",
          "label": "亮色"
        },
        {
          "value": "dark",
          "label": "暗色"
        }
      ],
      "help": "站点明暗；按北京时间自动那档＝19:00–07:00 用暗色（访客可自行覆盖）"
    },
    {
      "type": "number",
      "key": "pageWidth",
      "label": "内容宽度",
      "default": 85,
      "min": 60,
      "max": 100,
      "help": "页面内容占屏幕的百分比，60–100；窄屏（<1506px）仍是全宽，只有宽屏生效"
    }
  ]
}
